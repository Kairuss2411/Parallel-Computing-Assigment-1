  <diagram name="MCS" id="mcs">
    <mxGraphModel dx="1500" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="mcs-title" value="MCS: công bố node (release) và CAS tail (acq_rel) khi tìm successor" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="1200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="mcs-h1" value="A (đang giữ lock, tail = &amp;A)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1a73e8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="50" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mcs-h2" value="B (enqueue đồng thời với A.release)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#188038;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="50" width="480" height="30" as="geometry" />
        </mxCell>

        <mxCell id="mcs-time" style="edgeStyle=none;html=1;endArrow=classic;endSize=8;strokeColor=#9aa0a6;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="80" as="sourcePoint" />
            <mxPoint x="60" y="1270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-tlabel" value="thời gian" style="text;html=1;align=center;verticalAlign=middle;rotation=-90;fontSize=10.5;fontColor=#9aa0a6;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="5" y="605" width="50" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mcs-lane1" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#dadce0;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="105" as="sourcePoint" />
            <mxPoint x="420" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-lane2" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#dadce0;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="105" as="sourcePoint" />
            <mxPoint x="1060" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="mcs-b1" value="data = 42   (ghi trong CS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#e37400;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="175" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b2" value="A.next.load(acquire) → nullptr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="305" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b3" value="CAS(tail: &amp;A → nullptr, acq_rel)&#xa;→ false; expected = &amp;B" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="438" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-note1" value="failure order mặc định = acquire" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7b1fa2;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="270" y="530" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b4" value="while (!(A.next.load(acquire)))&#xa;    cpu_relax()   → &amp;B" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="728" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b5" value="B.locked.store(false, release)&#xa;bàn giao (giống TAS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="878" width="480" height="85" as="geometry" />
        </mxCell>

        <mxCell id="mcs-b6" value="tail.exchange(&amp;B, acq_rel) → &amp;A&#xa;(đưa B vào tail, đọc pred = &amp;A)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="368" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b7" value="B.locked.store(true, relaxed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="508" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mcs-note2" value="relaxed — lệnh release bên dưới sắp thứ tự" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#5f6368;strokeColor=none;fillColor=none;" vertex="1" parent="1">
