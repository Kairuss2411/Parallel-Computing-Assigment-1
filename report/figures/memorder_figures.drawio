        <mxCell id="mcs-b9" value="while (B.locked.load(acquire))&#xa;    cpu_relax()   (giống TAS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
