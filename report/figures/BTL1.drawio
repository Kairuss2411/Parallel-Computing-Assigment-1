        <mxCell id="c47" parent="c46" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" value="SPIN on own node" vertex="1">
          <mxGeometry height="28" width="206" x="12" y="38" as="geometry" />
