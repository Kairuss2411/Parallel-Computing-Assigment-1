        <mxCell id="c44" parent="c42" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" value="in critical section" vertex="1">
