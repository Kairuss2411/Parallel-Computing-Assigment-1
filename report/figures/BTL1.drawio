            <mxPoint x="820" y="1030" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-handoff-label" value="release → acquire" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#188038;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="665" y="885" width="160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="mcs-hb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 4;strokeColor=#34a853;strokeWidth=2;endArrow=block;endSize=8;endFill=1;" edge="1" parent="1">
