        <mxCell id="c51" parent="c50" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" value="SPIN on own node" vertex="1">
