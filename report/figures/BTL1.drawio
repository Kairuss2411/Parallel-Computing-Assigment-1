        <mxCell id="e79" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endSize=8;strokeColor=#57606a;strokeWidth=1.5;fontSize=12;fontColor=#57606a;labelBackgroundColor=#fbfcfd;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c78" target="c70"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c80" value="release(N1): succ = N1.next = N2&#10;→ N2.locked.store(false) wakes N2; N3 stays queued until N2 releases." style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#5c4700;" vertex="1" parent="1"><mxGeometry x="120" y="1075" width="760" height="80" as="geometry" /></mxCell>
        <mxCell id="c81" value="Caveat: my_node() is thread_local → a thread must hold at most one MCS lock at a time. Memory orders shown as relaxed / acquire / release / acq_rel." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1185" width="1520" height="30" as="geometry" /></mxCell>
