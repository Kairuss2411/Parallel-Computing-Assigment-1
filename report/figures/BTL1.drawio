        <mxCell id="e77" value="next" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endSize=8;strokeColor=#57606a;strokeWidth=1.5;fontSize=12;fontColor=#57606a;labelBackgroundColor=#fbfcfd;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c70" target="c74"><mxGeometry relative="1" as="geometry" /></mxCell>
