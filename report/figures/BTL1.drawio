<diagram name="MCS pseudocode" id="mcs-pseudocode">
    <mxGraphModel dx="1600" dy="1250" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="MCS Lock — FIFO queue spinlock" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=30;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="44" as="geometry" /></mxCell>
        <mxCell id="c3" value="Pseudocode from include/lock_mcs.h (C++20) · each waiter spins on its own cache-line-aligned node" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="26" as="geometry" /></mxCell>
        <mxCell id="c4" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#d0d7de;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="108" width="1520" height="1" as="geometry" /></mxCell>
        <mxCell id="c5" value="" style="rounded=1;html=1;fillColor=#f6f8fa;strokeColor=#d0d7de;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="740" height="160" as="geometry" /></mxCell>
        <mxCell id="c6" value="Node — one per thread, cache-line aligned" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="132" width="700" height="24" as="geometry" /></mxCell>
        <mxCell id="c7" value="struct alignas(64) MCSNode {" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="162" width="700" height="24" as="geometry" /></mxCell>
        <mxCell id="c8" value="    std::atomic&lt;MCSNode*&gt; next{nullptr};" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="186" width="700" height="24" as="geometry" /></mxCell>
        <mxCell id="c9" value="    std::atomic&lt;bool&gt;     locked{false};" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="700" height="24" as="geometry" /></mxCell>
        <mxCell id="c10" value="};" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="234" width="700" height="24" as="geometry" /></mxCell>
        <mxCell id="c11" value="" style="rounded=1;html=1;fillColor=#fff8e1;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="800" y="120" width="760" height="160" as="geometry" /></mxCell>
        <mxCell id="c12" value="Why it scales" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=16;fontColor=#7a5b00;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="132" width="720" height="24" as="geometry" /></mxCell>
        <mxCell id="c13" value="• FIFO fairness: tail.exchange() appends each waiter to the queue." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="164" width="720" height="26" as="geometry" /></mxCell>
        <mxCell id="c14" value="• Each thread spins on its own locked flag → no single hot cache line." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="192" width="720" height="26" as="geometry" /></mxCell>
        <mxCell id="c15" value="• O(1) space per thread; node is thread_local (one MCS lock per thread)." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="220" width="720" height="26" as="geometry" /></mxCell>
        <mxCell id="c16" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#d0d7de;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="740" height="390" as="geometry" /></mxCell>
        <mxCell id="c17" value="" style="rounded=0;html=1;fillColor=#0969da;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="740" height="6" as="geometry" /></mxCell>
        <mxCell id="c18" value="acquire()" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0b3d6e;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="316" width="700" height="32" as="geometry" /></mxCell>
        <mxCell id="c19" value="enqueue self, then wait until the predecessor hands off" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="700" height="22" as="geometry" /></mxCell>
        <mxCell id="c20" value="MCSNode&amp; me = my_node();" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="386" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c21" value="// thread_local" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="386" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c22" value="me.next.store(nullptr, relaxed);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="412" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c23" value="// clear stale link" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="412" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c24" value="MCSNode* pred = tail.exchange(&amp;me, acq_rel);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="438" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c25" value="// append to queue" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="438" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c26" value="if (pred != nullptr) {" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="464" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c27" value="    me.locked.store(true, relaxed);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c28" value="// wait for handoff" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="490" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c29" value="    pred-&gt;next.store(&amp;me, release);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="516" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c30" value="// publish my node" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="516" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c31" value="    while (me.locked.load(acquire))" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="542" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c32" value="// spin on MY flag" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="542" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c33" value="        cpu_relax();" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="568" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c34" value="// relaxed pause" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="568" width="170" height="24" as="geometry" /></mxCell>
        <mxCell id="c35" value="}" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="594" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c36" value="Only me.locked and pred-&gt;next are written; there is no shared spin line." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="636" width="700" height="38" as="geometry" /></mxCell>
        <mxCell id="c37" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#d0d7de;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="760" height="390" as="geometry" /></mxCell>
        <mxCell id="c38" value="" style="rounded=0;html=1;fillColor=#2da44e;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="760" height="6" as="geometry" /></mxCell>
        <mxCell id="c39" value="release()" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#0b5a2a;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="316" width="720" height="32" as="geometry" /></mxCell>
        <mxCell id="c40" value="hand off to the next waiter, or clear tail if the queue is empty" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="350" width="720" height="22" as="geometry" /></mxCell>
        <mxCell id="c41" value="MCSNode&amp; me = my_node();" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="386" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c42" value="// thread_local" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="386" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c43" value="MCSNode* succ = me.next.load(acquire);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="412" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c44" value="// successor link" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="412" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c45" value="if (succ == nullptr) {" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="438" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c46" value="    if (tail.compare_exchange_strong(" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="464" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c47" value="// try to clear tail" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="464" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c48" value="            &amp;me, nullptr, acq_rel))" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="490" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c49" value="        return;" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="516" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c50" value="// no waiter" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="516" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c51" value="    while ((succ = me.next.load(acquire))" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="542" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c52" value="// enqueue raced us" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="542" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c53" value="           == nullptr) cpu_relax();" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="568" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c54" value="// wait for link" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="568" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c55" value="}" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="594" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c56" value="succ-&gt;locked.store(false, release);" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="820" y="620" width="520" height="24" as="geometry" /></mxCell>
        <mxCell id="c57" value="// wake successor" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a737d;fontFamily=Consolas;spacing=0;" vertex="1" parent="1"><mxGeometry x="1350" y="620" width="180" height="24" as="geometry" /></mxCell>
        <mxCell id="c58" value="The CAS handles the race with a concurrent enqueue into an empty queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="820" y="652" width="720" height="38" as="geometry" /></mxCell>
        <mxCell id="c59" value="" style="rounded=1;html=1;fillColor=#fbfcfd;strokeColor=#d0d7de;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1520" height="430" as="geometry" /></mxCell>
        <mxCell id="c60" value="Queue state under contention (FIFO)" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="742" width="1000" height="26" as="geometry" /></mxCell>
        <mxCell id="c61" value="N1 holds the lock; N2 and N3 wait on their own nodes. Arrows are next links." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="772" width="1200" height="22" as="geometry" /></mxCell>
        <mxCell id="c62" value="N1 — holder" style="swimlane;startSize=30;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="880" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="c63" value="next → N2" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c62"><mxGeometry x="12" y="34" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c64" value="locked = false" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c62"><mxGeometry x="12" y="66" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c65" value="state: in critical section" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c62"><mxGeometry x="12" y="98" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c66" value="N2 — waiter" style="swimlane;startSize=30;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="880" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="c67" value="next → N3" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c66"><mxGeometry x="12" y="34" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c68" value="locked = true" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c66"><mxGeometry x="12" y="66" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c69" value="spins on N2.locked" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c66"><mxGeometry x="12" y="98" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c70" value="N3 — waiter" style="swimlane;startSize=30;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="920" y="880" width="240" height="150" as="geometry" /></mxCell>
        <mxCell id="c71" value="next = null" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c70"><mxGeometry x="12" y="34" width="216" height="26" as="geometry" /></mxCell>
        <mxCell id="c72" value="locked = true" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Consolas;spacing=0;" vertex="1" parent="c70"><mxGeometry x="12" y="66" width="216" height="26" as="geometry" /></mxCell>
