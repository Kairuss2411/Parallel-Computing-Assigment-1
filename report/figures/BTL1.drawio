        <mxCell id="mcs-hblabel" value="happens-before" style="text;html=1;align=center;verticalAlign=middle;rotation=-90;fontSize=11;fontColor=#188038;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1435" y="620" width="40" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mcs-bottom" value="Các thao tác trên locked (spin acquire + handoff release) giữ nguyên scheme acquire/release của TAS." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#dadce0;fontSize=10.5;" vertex="1" parent="1">
          <mxGeometry x="180" y="1252" width="1200" height="45" as="geometry" />
