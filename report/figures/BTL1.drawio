        <mxCell id="c46" parent="1" style="swimlane;startSize=30;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" value="Thread 2 — waiter" vertex="1">
          <mxGeometry height="160" width="230" x="540" y="720" as="geometry" />
