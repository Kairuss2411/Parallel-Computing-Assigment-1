        <mxCell id="c48" parent="c46" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" value="waiting for HANDOFF" vertex="1">
