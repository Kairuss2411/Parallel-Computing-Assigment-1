        <mxCell id="c53" parent="c50" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;" value="FIFO #2" vertex="1">
