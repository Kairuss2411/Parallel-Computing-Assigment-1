        <mxCell id="c50" parent="1" style="swimlane;startSize=30;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" value="Thread 3 — waiter" vertex="1">
          <mxGeometry height="160" width="230" x="940" y="720" as="geometry" />
