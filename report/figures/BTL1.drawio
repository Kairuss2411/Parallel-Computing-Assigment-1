            <mxPoint x="60" y="80" as="sourcePoint" />
            <mxPoint x="60" y="1270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-tlabel" value="thời gian" style="text;html=1;align=center;verticalAlign=middle;rotation=-90;fontSize=10.5;fontColor=#9aa0a6;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="5" y="605" width="50" height="140" as="geometry" />
        </mxCell>

        <mxCell id="mcs-lane1" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#dadce0;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="105" as="sourcePoint" />
            <mxPoint x="420" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-lane2" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#dadce0;strokeWidth=1.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1060" y="105" as="sourcePoint" />
            <mxPoint x="1060" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="mcs-b1" value="data = 42   (ghi trong CS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#e37400;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="175" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b2" value="A.next.load(acquire) → nullptr" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="305" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b3" value="CAS(tail: &amp;A → nullptr, acq_rel)&#10;→ false; expected = &amp;B" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="438" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-note1" value="failure order mặc định = acquire" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7b1fa2;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="270" y="530" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b4" value="while (!(A.next.load(acquire)))&#10;    cpu_relax()   → &amp;B" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="728" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b5" value="B.locked.store(false, release)&#10;bàn giao (giống TAS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="878" width="480" height="85" as="geometry" />
        </mxCell>

        <mxCell id="mcs-b6" value="tail.exchange(&amp;B, acq_rel) → &amp;A&#10;(đưa B vào tail, đọc pred = &amp;A)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="368" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b7" value="B.locked.store(true, relaxed)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="508" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mcs-note2" value="relaxed — lệnh release bên dưới sắp thứ tự" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#5f6368;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="800" y="585" width="520" height="28" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b8" value="A.next.store(&amp;B, release)&#10;(công bố node B)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d93025;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="628" width="480" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b9" value="while (B.locked.load(acquire))&#10;    cpu_relax()   (giống TAS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1f3f4;strokeColor=#5f6368;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="790" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b10" value="B.locked.load(acquire) → false&#10;B giữ lock (giống TAS)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="990" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mcs-b11" value="đọc data → 42" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="1125" width="480" height="70" as="geometry" />
        </mxCell>

        <mxCell id="mcs-exchange-cas" style="edgeStyle=none;curved=1;dashed=1;dashPattern=5 4;html=1;endArrow=block;endSize=7;endFill=1;strokeColor=#7b1fa2;strokeWidth=1.8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="410" as="sourcePoint" />
            <mxPoint x="660" y="480" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-excas-label" value="tail = &amp;B ⇒ CAS fail" style="text;html=1;align=center;verticalAlign=middle;fontSize=9.5;fontColor=#7b1fa2;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="665" y="360" width="150" height="28" as="geometry" />
        </mxCell>

        <mxCell id="mcs-publish-retry" style="edgeStyle=none;curved=1;html=1;endArrow=block;endSize=8;endFill=1;strokeColor=#188038;strokeWidth=2.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="670" as="sourcePoint" />
            <mxPoint x="660" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mcs-pub-label" value="release → acquire" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#188038;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="645" y="630" width="170" height="30" as="geometry" />
        </mxCell>

        <mxCell id="mcs-handoff" style="edgeStyle=none;curved=1;html=1;endArrow=block;endSize=8;endFill=1;strokeColor=#188038;strokeWidth=2.2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
