        <mxCell id="c43" parent="c42" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" value="owns the lock" vertex="1">
