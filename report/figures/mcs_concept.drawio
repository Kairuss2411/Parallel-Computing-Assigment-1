        <mxCell id="c61" value="FIFO fairness: RELEASE wakes only the next waiter;&#xa;all other waiters keep spinning." style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#5c4700;" vertex="1" parent="1"><mxGeometry x="140" y="950" width="740" height="70" as="geometry"/></mxCell>
        <mxCell id="c62" value="Each node has its own cache line, so waiters do not&#xa;hammer a shared flag." style="rounded=1;html=1;fillColor=#e8f4ea;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=12;fontSize=13;fontColor=#1e4a1e;" vertex="1" parent="1"><mxGeometry x="920" y="950" width="480" height="70" as="geometry"/></mxCell>
        <mxCell id="c63" value="HANDOFF is a wake-up, not a broadcast: exactly one waiter becomes the next holder." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#57606a;fontFamily=Helvetica;spacing=0;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1060" width="1520" height="30" as="geometry"/></mxCell>
