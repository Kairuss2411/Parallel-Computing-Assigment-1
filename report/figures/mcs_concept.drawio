        <mxCell id="c3" value="A FIFO queue of waiters: each thread spins on its own node, and the holder hands the lock to the next waiter." style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1520" height="26" as="geometry"/></mxCell>
