        <mxCell id="c5" value="Lifecycle of one thread" style="text;html=1;whiteSpace=nowrap;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f2328;fontFamily=Helvetica;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="900" height="28" as="geometry"/></mxCell>
        <mxCell id="c6" value="" style="rounded=1;html=1;fillColor=#fbfcfd;strokeColor=#d0d7de;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1520" height="370" as="geometry"/></mxCell>
