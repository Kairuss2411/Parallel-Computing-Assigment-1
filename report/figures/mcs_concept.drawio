        <mxCell id="c10" value="ask for the lock" style="text;html=1;whiteSpace=nowrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#57606a;fontFamily=Helvetica;spacing=0;" vertex="1" parent="c8"><mxGeometry x="0" y="38" width="150" height="22" as="geometry"/></mxCell>
